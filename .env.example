# Sage — environment reference. Copy to `.env` and fill in.
# Next.js loads `.env` automatically. NOTHING real here — placeholders only.
# Missing values degrade honestly (heuristic brain, "pending" x402, etc.);
# malformed values hard-fail at boot (see src/lib/env.ts).

# ── Network + RPC ───────────────────────────────────────────────────────
DEPUTY_NETWORK=metis-sepolia            # metis-sepolia | metis-andromeda
METIS_SEPOLIA_RPC=https://sepolia.metisdevops.link
METIS_RPC=https://andromeda.metis.io/?owner=1088
GOAT_RPC_URL=https://rpc.goat.network

# ── On-chain addresses (filled after deploying the PolicyVault) ─────────
NEXT_PUBLIC_VAULT_ADDRESS=0x...         # the funding vault campaigns pay from
NEXT_PUBLIC_USDC_ADDRESS=0x...
NEXT_PUBLIC_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_OPERATOR_ADDRESS=0x...      # public address of the operator key
NEXT_PUBLIC_KILL_VAULT_ADDRESS=0x...
GOAT_FACTORY_ADDRESS=0x...              # GOAT mainnet vault stack (optional)
GOAT_VAULT_ADDRESS=0x...

# ── Signing keys — SERVER ONLY, NEVER COMMIT, NEVER LOG ─────────────────
# The Deputy signs vault writes with this. Also read from contracts/.env PRIVATE_KEY.
OPERATOR_PRIVATE_KEY=0x...
GOAT_AGENT_PRIVATE_KEY=0x...            # GOAT mainnet (chainId 2345) signer
OPERATOR_GAS_FLOOR_WEI=                 # BTC (wei) the operator keeps for settlements before covering a founder's launch gas; default 5000000000000 (0.000005 BTC)

# ── LLM brain — provider-agnostic (OpenAI-compatible) ──────────────────
# Prefer LLM_*; COMMONSTACK_* is the legacy fallback. Missing key → heuristic.
# Chain: primary → fallback → heuristic (heuristic can never auto-pay).
LLM_BASE_URL=https://api.commonstack.ai/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3.1-flash-lite-preview
COMMONSTACK_API_KEY=
COMMONSTACK_BASE_URL=https://api.commonstack.ai/v1
DEPUTY_MODEL=

# Fallback provider — a DIFFERENT provider the brain fails over to ONCE when the
# primary is exhausted. Demo-day insurance: a primary outage can't silently drop
# autopilot to the heuristic. Use a cross-provider endpoint (e.g. OpenRouter) so a
# single provider going down is survivable. All three arm it; a fallback success
# is still engine "llm". Red-team any fallback model before relying on it.
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek/deepseek-chat

# ── x402 (GOAT) merchant credentials — optional payment rail ───────────
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_MERCHANT_ID=
GOATX402_API_URL=https://flow-api.goat.network

# ── ERC-8004 identity (written by scripts/register-erc8004.mjs) ────────
ERC8004_AGENT_ID=                       # numeric agent id; presence = registered
ERC8004_AGENT_ADDRESS=0x...
ERC8004_AGENT_NAME=Sage

# ── Telegram (optional bot + notifications) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                       # private held/paid operator pings
TELEGRAM_WEBHOOK_SECRET=                # enables POST /api/telegram/webhook
TELEGRAM_ANNOUNCE_CHAT_ID=              # public per-campaign announces

# ── Autonomy + public URLs + secrets ───────────────────────────────────
DEPUTY_AUTOPILOT_MAINNET=false          # arm auto-pay of REAL money on GOAT 2345
DEPUTY_DEBUG=
NEXT_PUBLIC_APP_URL=https://your-deploy.example
NEXT_PUBLIC_SITE_URL=https://your-deploy.example
SAGE_SESSION_SECRET=                    # REQUIRED in production (SIWE sessions)
DEPUTY_CRON_SECRET=                     # authorizes the autopilot sweep
CRON_SECRET=                            # authorizes Vercel Cron
SAGE_AGENT_API_KEY=                     # Bearer token for the ClawUp Sage Agent API (unset → /api/agent/* fails closed 404)

# ── Lanes — route one job to its own provider (all THREE together, or the lane is absent) ──
# A lane set partially is ignored, never merged (a key on the wrong endpoint fails at a founder's launch).
MISSION_API_KEY=                        # the MISSION lane (architect + critic); prod: MiniMax-M3
MISSION_BASE_URL=
MISSION_MODEL=
CONCIERGE_API_KEY=                      # the Telegram/web concierge — its own budget, so chat can't starve judgment
CONCIERGE_BASE_URL=
CONCIERGE_MODEL=
CONCIERGE_DAILY_CAP=60                  # concierge turns per chat per day (slash commands uncapped)
INSPECTION_DAILY_CAP=3                  # inspections started per chat per day

# ── The eyes — browsing, replay, vision ───────────────────────────────────
FIELD_TEST_ENABLED=                     # "1": Sage browses the product in a real headless browser (npx playwright install --with-deps chromium)
INSPECTION_REPLAY_MODE=                 # "shadow": re-perform a safe observed transition; REQUIRED for grounded action missions

# ── The V2 campaign vaults — per chain ───────────────────────────────────
GOAT_CAMPAIGN_FACTORY_ADDRESS=          # V2 CampaignVault factory on GOAT (deploy can't create vaults without it)
METIS_CAMPAIGN_FACTORY_ADDRESS=         # …and on Metis Sepolia
GOAT_OPERATOR_ADDRESS=                  # the operator baked into every vault's settings

# ── Walletless founders and email sign-in (Privy — two SEPARATE apps) ─────
PRIVY_APP_ID=                           # server wallets for Telegram founders + the mandate policy
PRIVY_APP_SECRET=                       # the master credential for every agent wallet — server only
NEXT_PUBLIC_PRIVY_LOGIN_APP_ID=         # the app that signs people IN (email + embedded wallet); needed at BUILD time
PRIVY_LOGIN_APP_SECRET=

# ── Starknet — the private rail ──────────────────────────────────────────
STARKNET_RPC_URL=                       # all three arm the rail; the account is the Cairo vault's operator
STARKNET_ACCOUNT_ADDRESS=
STARKNET_PRIVATE_KEY=                   # SERVER ONLY
STARKNET_VAULT_CLASS_HASH=              # the declared SageVault class new vaults deploy from
STARKNET_VAULT_CLASS_HASHES_PREVIOUS=   # comma-separated earlier classes that stay recognised

# ── Identity — one person, one slot ──────────────────────────────────────
WORLD_ID_APP_ID=                        # World developer-portal app (app_…); with the RP id + signing key it arms proof of personhood
NEXT_PUBLIC_WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_RP_SIGNING_KEY=
WORLD_ID_ACTION=sage-worker
IDENTITY_DOOR=                          # "1": public work asks for the proof at the mission; caps count the PERSON (armed on prod)
IDENTITY_TIERS=                         # "1": the older reward-size standing rule (superseded when the door is armed)
IDENTITY_OPEN_CEILING_USD=2             # the reward at or below which work is open under the tier rule

# ── Working capital — the advance on /record ──────────────────────────────
ADVANCE_SELF_SERVE=                     # "1": the owner's one-click advance; money is the operator's Starknet pot
ADVANCE_MAX_USD=5
ADVANCE_MULTIPLE=1                      # the lender multiple on monthly verified inflow
ADVANCE_WATERFALL_BPS=5000              # share of each next verified payout that repays

# ── Autopilot pace + operator secrets ────────────────────────────────────
AUTOPAY_HOURLY_CAP=4                    # payouts per campaign per hour before the autopilot holds on pace
AUTOPAY_FINALIZE_MINUTES=30             # the window on an open campaign before an approval settles
SAGE_ADMIN_SECRET=                      # out-of-band held-work review (POST /api/admin/review); unset → 404
